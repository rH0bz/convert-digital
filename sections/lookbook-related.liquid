{%- comment -%}
  ============================================================================
  Related lookbook — the lookbook, narrowed to the product being viewed.

  Same renderer and same templates as sections/lookbook.liquid; the difference
  is which looks appear and why. There is no entry picker here: the metaobject
  already records which products belong to which look, so that relationship IS
  the condition. A look shows up on a product page when it features that
  product — through its picked products, or through the collection it points at
  — which makes this behave like related products without a second field to
  maintain.

  The product being viewed is left out of the looks it appears in, so the page
  never recommends itself.

  Templates are forced to one choice for the whole section rather than following
  each entry's own Template field. A product page wants one consistent block; a
  look configured as Full width for the lookbook page should not break out of
  the product layout here.

  Renders nothing at all when no look features the product, so it is safe to
  leave on the product template for every product.
  ============================================================================
{%- endcomment -%}

{{ 'section-lookbook.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lookbook.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding isolate">
    {%- comment -%}
      `exclude_product` is passed separately from `containing_product` rather
      than being implied by it: they are different questions — which looks to
      show, and which product to leave out of them — and the merchant can turn
      the second off without losing the first.
    {%- endcomment -%}
    {%- liquid
      # Left unassigned when the merchant turns the option off, rather than
      # assigned `nil`: an unset variable is nil in Liquid either way, and this
      # avoids depending on how a given Liquid implementation parses the `nil`
      # literal in an assign.
      if section.settings.exclude_current_product
        assign excluded = product
      endif
    -%}
    {%- render 'lookbook',
      uid: section.id,
      containing_product: product,
      exclude_product: excluded,
      force_template: section.settings.template,
      entries_limit: section.settings.entries_limit,
      products_limit: section.settings.products_limit,
      heading: section.settings.heading,
      heading_size: section.settings.heading_size,
      sub_heading: section.settings.sub_heading,
      description: section.settings.description,
      show_sub_heading: section.settings.show_sub_heading,
      show_description: section.settings.show_description,
      masonry_row_height: section.settings.masonry_row_height,
      product_cta_label: section.settings.product_cta_label
    -%}
  </div>
</div>

{% schema %}
{
  "name": "Related lookbook",
  "class": "section",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the lookbook entries that already feature the product being viewed. Add a product to a look in Settings > Custom data and it appears here — there is nothing to pick in this section."
    },
    {
      "type": "select",
      "id": "template",
      "options": [
        { "value": "masonry", "label": "Masonry" },
        { "value": "masonry_product_images", "label": "Masonry - Product Images" },
        { "value": "default", "label": "Default (one row)" },
        { "value": "full_width", "label": "Full width (one row)" }
      ],
      "default": "masonry",
      "label": "Template",
      "info": "Applies to every look in this section, ignoring the Template field on the entries themselves."
    },
    {
      "type": "range",
      "id": "entries_limit",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1,
      "label": "Maximum looks to show",
      "info": "A product can belong to more than one look. They appear in the order set in Settings > Custom data."
    },
    {
      "type": "checkbox",
      "id": "exclude_current_product",
      "default": true,
      "label": "Hide the product being viewed",
      "info": "Leaves this product out of the looks it appears in, so the page does not recommend itself."
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Shop the look",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Look content"
    },
    {
      "type": "checkbox",
      "id": "show_sub_heading",
      "default": false,
      "label": "Show sub heading on each look"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "default": false,
      "label": "Show description on each look"
    },
    {
      "type": "text",
      "id": "product_cta_label",
      "default": "Shop now",
      "label": "Product button label",
      "info": "Shown over each product image, under the product title. Leave empty to show the title alone."
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 6,
      "label": "Maximum products per look",
      "info": "Counted after the product being viewed is removed, so this is how many you actually see."
    },
    {
      "type": "range",
      "id": "masonry_row_height",
      "min": 60,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 100,
      "label": "Masonry row height",
      "info": "Only affects the two Masonry templates. Cards are 3 or 4 of these tall. Phones use 75% of this."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Related lookbook"
    }
  ]
}
{% endschema %}
